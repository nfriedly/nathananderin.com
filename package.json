{
  "name": "nathananderin.com",
  "version": "2.0.0",
  "description": "Nathan and Erin Friedly: reviews of things we buy",
  "main": "index.js",
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy",
    "capture-server": "node local-notes/capture-server.js",
    "test": "npm run lint && npm run build -- --quiet",
    "lint-ejs": "ejslint src/_includes/",
    "lint-rest": "eslint .",
    "lint-fix": "eslint . --fix",
    "lint": "npm run lint-ejs && npm run lint-rest"
  },
  "keywords": [
    "reviews",
    "eleventy",
    "family"
  ],
  "author": "Nathan Friedly",
  "license": "MIT",
  "dependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-plugin-ejs": "^1.0.0",
    "ejs-lint": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
