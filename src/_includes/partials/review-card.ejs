<%_ function starsHtml(n) {
    let s = '<span class="stars" aria-label="' + n + ' out of 5 stars">';
    for (let i = 1; i <= 5; i++) {
        s += (n >= i) ? '<i class="fa-solid fa-star"></i>'
            : (n >= i - 0.5) ? '<i class="fa-solid fa-star-half-stroke"></i>'
            : '<i class="fa-regular fa-star"></i>';
    }
    return s + '</span>';
} _%>
<%_ function thumbUrl(url) {
    if (!url) return '';
    var m = url.match(/^(.*\/)([^/]+)$/);
    if (!m) return url;
    var base = m[2].replace(/\.[^.]+$/, '');
    return m[1] + 'thumbs/' + base + '.jpg';
} _%>
<% var thumb = photo || productImage; %>
<a class="review-card" href="<%= url %>" data-author="<%= author %>" data-tags="<%= (tags || []).filter(t => t !== 'review').join(' ') %>">
	<% if (showBoth && productImage && thumb && productImage !== thumb) { %>
		<img class="product-photo" src="<%= thumbUrl(productImage) %>" alt="">
	<% } %>
	<% if (thumb) { %><img class="product-thumb" src="<%= thumbUrl(thumb) %>" alt=""><% } %>
	<h2><%= title %></h2>
	<p class="review-meta"><%- starsHtml(stars) %><% if (product && product.name) { %> &middot; <%= product.name %><% } %></p>
	<p class="excerpt"><%= excerpt %></p>
</a>