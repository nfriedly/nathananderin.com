{% set navClass = navClass or '' %}
{% set navContainer = navContainer | default(true) %}
<nav class="navbar navbar-default navbar-static-top {{ navClass }}">
    {% if navContainer %}<div class="container">{% endif %}
        <div class="navbar-header">
            <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#nav-menu" aria-expanded="false" aria-controls="nav-menu">
                <span class="sr-only">Toggle navigation</span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>
        </div>
        <div id="nav-menu" class="collapse navbar-collapse">
            <ul class="nav navbar-nav navbar-right">
                <li{% if section == 'home' %} class="active"{% endif %}><a href="/"><i class="fa fa-home"></i> Home</a></li>
                <li{% if section == 'reviews' %} class="active"{% endif %}><a href="/reviews/"><i class="fa fa-star"></i> Reviews</a></li>
                <li{% if section == 'books' %} class="active"{% endif %}><a href="/book-reviews/"><i class="fa fa-book"></i> Books</a></li>
            </ul>
        </div>
    {% if navContainer %}</div>{% endif %}
</nav>
