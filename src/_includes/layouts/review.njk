---
layout: main
cssClass: review single
navInHeader: true
---

{% set h1 = title or (product.name ~ (product.name | reviewSuffix(tags))) %}
{% if subTitle %}
    {% set h2 = subTitle %}
{% elif title and product and product.name %}
    {% set h2 = product.name ~ (product.name | reviewSuffix(tags)) %}
{% else %}
    {% set h2 = '' %}
{% endif %}

{% if images and images.hero %}
<header class="hero review-hero" style="--bg-img: url('{{ images.hero }}');">
    {% set navClass = 'navbar-transparent' %}
    {% set navContainer = false %}
    {% include "partials/navbar.njk" %}
    <h1><span>{{ h1 }}</span></h1>
    {% if h2 %}<h2><span>{{ h2 }}</span></h2>{% endif %}
    <p class="review-meta"><span>
        {{ stars | starsHtml | safe }}
        by {{ authorName(author) }} Friedly
    </span></p>
</header>
{% else %}
{% set navContainer = false %}
{% include "partials/navbar.njk" %}
<h1>{{ h1 }}</h1>
{% if h2 %}<h2>{{ h2 }}</h2>{% endif %}
<p class="review-meta">
    {{ stars | starsHtml | safe }}
    {% if product and product.author %}Reviewed {% endif %} by {{ authorName(author) }} Friedly
</p>
{% endif %}

<main>

<div class="review-main">

{% if (product and (product.name or product.title)) or (images and images.product) or reviewUrl %}
<div class="review-box card{% if images and images.hero %} has-hero{% endif %}">
    <div class="card-body">
    <div class="row">
        {% if images and images.product %}
        <div class="col-md-3">
            <img class="img-fluid" width="476" src="{{ page.url }}{{ images.product }}" alt="{{ product.title or product.name or '' }}">
        </div>
        <div class="col-md-9">
        {% else %}
        <div class="col-md-12">
        {% endif %}
            {% if product and (product.title or product.name) %}<h2>{{ product.title or product.name }}</h2>{% endif %}
            {% if product and product.author %}<p class="product-author">by {{ product.author }}</p>{% endif %}
            {% if product and product.price %}<p class="product-price">Price: {% if product.price is number %}${{ product.price | money }}{% else %}{{ product.price }}{% endif %}</p>{% endif %}
            {% set buys = buyLinks(product) %}
            {% if buys.length %}
            <p>
                {% for buy in buys %}
                <a class="btn btn-primary btn-buy" href="{{ buy.href }}" target="_blank" rel="nofollow sponsored noopener">
                    {% if buy.favicon %}<img class="site-favicon" src="{{ buy.favicon }}" alt="" width="32" height="32">{% endif %}
                    {{ buy.site }}
                </a>
                {% endfor %}
            </p>
            {% for buy in buys %}{% if buy.originalUrl %}<p>Original URL: <code>{{ buy.originalUrl }}</code></p>{% endif %}{% endfor %}
            {% endif %}
            {% if orderDate %}<p>Ordered on: {{ orderDate }}</p>{% endif %}
            {% if reviewDate %}<p>Reviewed on: {{ reviewDate }}</p>{% endif %}
        </div>
    </div>
    </div>
</div>
{% endif %}

<div class="review-body">
{{ content | safe }}
</div>

</div>

{% if images and images.photos and images.photos.length %}
{% for row in images.photos | batch(4) %}
<div class="review-photos row">
  {% for photo in row %}
    {% set alt = photo | stripExt | stripLeadingNumber %}
    {% set src = page.url ~ photo %}
    <div class="col-12 col-md-6 col-lg-3">
      <figure class="card review-photo-card">
        {% if photo.endsWith('.mp4') %}
          <video controls preload="metadata" class="review-photo-media">
            <source src="{{ src }}" type="video/mp4">
          </video>
        {% else %}
          <a href="{{ src }}" class="review-photo-link">
            <img class="card-img-top review-photo-media" width="558" src="{{ src }}" alt="{{ alt }}">
          </a>
        {% endif %}
        <figcaption class="card-body caption py-2 px-2">{{ alt }}</figcaption>
      </figure>
    </div>
  {% endfor %}
</div>
{% endfor %}
{% endif %}

{% if reviewUrl %}
<p class="review-origin">This review originally appeared on <a href="{{ affiliateUrl(reviewUrl) }}" rel="alternate">{{ reviewUrl | sourceLabel }}</a>, however nathananderin.com should be considered the canonical source as I keep it up-to-date over time.</p>
{% endif %}

</main>

{% set specifiedUrls = relatedReviews | default([]) %}
{% set relatedItems = collections.allReviews | relatedReviews(tags, page.url, specifiedUrls) %}
{% if relatedItems.length %}
<div class="related-reviews">
    <h2>You might also like</h2>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    {% for item in relatedItems %}
        {% set img = false %}
        {% if item.data.images and item.data.images.photos and item.data.images.photos.length and not item.data.images.photos[0].endsWith('.mp4') %}
            {% set img = item.url ~ item.data.images.photos[0] %}
        {% endif %}
        {% if not img and item.data.images and item.data.images.product %}
            {% set img = item.url ~ item.data.images.product %}
        {% endif %}
        <div class="col">
            <a class="card h-100 related-review-card text-body text-decoration-none" href="{{ item.url }}">
                {% if img %}<img class="card-img-top related-card-img" width="390" src="{{ img }}" alt="{{ item.data | reviewH1Title }}" loading="lazy">{% endif %}
                <div class="card-body">
                    <h3>{{ item.data | reviewH1Title }}</h3>
                    {% set subtitle = item.data | reviewH2Title %}
                    {% if subtitle %}<p class="related-subtitle card-text">{{ subtitle }}</p>{% endif %}
                </div>
            </a>
        </div>
    {% endfor %}
    </div>
</div>
{% endif %}

{% include "partials/disclosure.njk" %}