---
layout: main
cssClass: review single
---

<p><a href="/reviews/"><i class="fa fa-arrow-left"></i> All reviews</a></p>

<%_ function starsHtml(n) {
    let s = '<span class="stars" aria-label="' + n + ' out of 5 stars">';
    for (let i = 1; i <= 5; i++) {
        s += (n >= i) ? '<i class="fa-solid fa-star"></i>'
            : (n >= i - 0.5) ? '<i class="fa-solid fa-star-half-stroke"></i>'
            : '<i class="fa-regular fa-star"></i>';
    }
    return s + '</span>';
} _%>

<h1><%= title %></h1>
<p class="review-meta">
    <%- starsHtml(stars) %>
    by <%= author === 'erin' ? 'Erin' : 'Nathan' %> Friedly
    <% if (typeof product !== 'undefined' && product && product.name) { %> &middot; <%= product.name %><% } %>
</p>

<% if ((typeof product !== 'undefined' && product && (product.name || product.title)) || (typeof images !== 'undefined' && images && images.product) || (typeof reviewUrl !== 'undefined' && reviewUrl)) { %>
<div class="review-box">
    <div class="row">
        <% if (images && images.product) { %>
        <div class="col-sm-3">
            <img class="img-responsive" src="<%= page.url + images.product %>" alt="<%= product.title || product.name || '' %>">
        </div>
        <div class="col-sm-9">
        <% } else { %>
        <div class="col-sm-12">
        <% } %>
            <% if (product && (product.title || product.name)) { %><h2><%= product.title || product.name %></h2><% } %>
            <% if (product && product.price) { %><p class="product-price">Price: <% if (typeof product.price === 'number') { %>$<%= Number(product.price).toFixed(2) %><% } else { %><%= product.price %><% } %></p><% } %>
            <% if (product && product.urls && product.urls.length) { %>
            <p>
                <% for (const link of product.urls) { %>
                <a class="btn btn-primary btn-buy" href="<%= affiliateUrl(link.url) %>" target="_blank" rel="nofollow sponsored noopener">
                    <i class="fa fa-cart-shopping"></i> Buy from <%= (link.site || product.site) || 'Amazon' %>
                </a>
                <% } %>
            </p>
            <% } else if (product && product.url) { %>
            <p>
                <a class="btn btn-primary btn-buy" href="<%= affiliateUrl(product.url) %>" target="_blank" rel="nofollow sponsored noopener">
                    <i class="fa fa-cart-shopping"></i> Buy from <%= (product && product.site) || 'Amazon' %>
                </a>
            </p>
            <% } %>
            <% if (typeof reviewUrl !== 'undefined' && reviewUrl) { %>
            <p><a href="<%= affiliateUrl(reviewUrl) %>" target="_blank" rel="noopener">Read this review on Amazon <i class="fa fa-external-link"></i></a></p>
            <% } %>
        </div>
    </div>
</div>
<% } %>

<div class="review-body">
<%- content %>
</div>

<%_ function sourceLabel(url) {
    url = String(url).replace(/^https?:\/\//i, '').replace(/^www\./i, '');
    const host = url.split('/')[0].split(':')[0];
    const labels = {
        'amazon.com': 'Amazon', 'amazon.ca': 'Amazon', 'amazon.co.uk': 'Amazon', 'amazon.de': 'Amazon', 'amazon.fr': 'Amazon',
        'aliexpress.com': 'Ali Express', 'alibaba.com': 'Ali Baba'
    };
    return labels[host] || host;
} _%>
<% if (typeof reviewUrl !== 'undefined' && reviewUrl) { %>
<p class="review-origin">This review originally appeared on <a href="<%= affiliateUrl(reviewUrl) %>" rel="alternate"><%= sourceLabel(reviewUrl) %></a>, however nathananderin.com should be considered the canonical source as I keep it up-to-date over time.</p>
<% } %>

<%- include('../partials/disclosure.ejs') %>