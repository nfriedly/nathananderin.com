---
layout: main
tags: []
title: "Reviews (2)"
section: reviews
---

<main>
<h1>Reviews by Nathan and Erin (2)</h1>

<div class="review-filters">
	<span class="review-filters-label">Filter by reviewer:</span>
	<a class="review-filter btn btn-outline-info btn-sm" data-author="" href="/reviews/">All</a>
	<a class="review-filter btn btn-outline-info btn-sm" data-author="nathan" href="/reviews/?author=nathan">Nathan <span class="badge">{{ collections.reviews | countByAuthor('nathan') }}</span></a>
	<a class="review-filter btn btn-outline-info btn-sm" data-author="erin" href="/reviews/?author=erin">Erin <span class="badge">{{ collections.reviews | countByAuthor('erin') }}</span></a>
</div>

{% set tagFilters = collections.reviews | tagGroups %}

<div class="review-filters">
	<span class="review-filters-label">Filter by tag:</span>
	<a class="review-filter btn btn-outline-info btn-sm" data-tag="" href="/reviews/">All</a>
	{% for t in tagFilters.topTags %}
	<a class="review-filter btn btn-outline-info btn-sm" data-tag="{{ t.name }}" href="/reviews/?tag={{ t.name }}">{{ t.name }} <span class="badge">{{ t.count }}</span></a>
	{% endfor %}
	{% if tagFilters.moreTags.length %}
	<button type="button" class="review-tags-toggle btn btn-outline-info btn-sm">More tags&hellip;</button>
	<span class="review-tags-more" hidden>
		{% for t in tagFilters.moreTags %}
		<a class="review-filter btn btn-outline-info btn-sm" data-tag="{{ t.name }}" href="/reviews/?tag={{ t.name }}">{{ t.name }} <span class="badge">{{ t.count }}</span></a>
		{% endfor %}
	</span>
	{% endif %}
	<a class="review-filter-clear" href="/reviews/">Clear filter [X]</a>
</div>

<div class="reviews">
{% set showBoth = true %}
{% for post in collections.reviewsEnd %}
    {% include "partials/review-card.njk" %}
{% endfor %}
</div>

<p><a href="/reviews/">Back to page 1</a></p>
</main>

<script src="/scripts/reviews.js"></script>