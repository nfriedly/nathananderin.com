---
layout: main
title: Poetry
section: poetry
---

<main>
<h1>Poetry by Nathan and Erin</h1>

<div class="review-filters">
	<span class="review-filters-label">Filter by author:</span>
	<a class="review-filter btn btn-outline-info btn-sm" data-author="" href="/poetry/">All</a>
	<a class="review-filter btn btn-outline-info btn-sm" data-author="nathan" href="/poetry/?author=nathan">Nathan <span class="badge">{{ collections.poetry | countByAuthor('nathan') }}</span></a>
	<a class="review-filter btn btn-outline-info btn-sm" data-author="erin" href="/poetry/?author=erin">Erin <span class="badge">{{ collections.poetry | countByAuthor('erin') }}</span></a>
	<a class="review-filter-clear" href="/poetry/">Clear filter [X]</a>
</div>

<div class="reviews">
{% for post in collections.poetryStart %}
    {% include "partials/piece-card.njk" %}
{% endfor %}
{% if collections.poetry.length > 10 %}
<div id="load-more" class="text-center">
	<a id="load-more-link" href="/poetry/2/">Load more&hellip;</a>
	<span id="load-more-loading" hidden><i class="fa-solid fa-spinner fa-spin"></i> Loading&hellip;</span>
</div>
{% endif %}
</div>
</main>

<script src="/scripts/reviews.js"></script>